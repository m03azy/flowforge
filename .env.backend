# Environment variables for backend running inside Docker compose
DATABASE_URL=postgresql://flowforge:secret@db:5432/flowforge
JWT_SECRET_KEY=dev-secret-key-autoflow-ai-super-long-unbreakable-token-12345
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=*
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBqOiIjJ5Pi2MvzVjUu9DsfziBlTompttU

# ── Email / SendGrid ────────────────────────────────────────
# Get your free SendGrid API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# The FROM address must be verified in your SendGrid account
# See: https://app.sendgrid.com/settings/sender_auth
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=FlowForge

# Optional: reply-to address (leave blank to use FROM address)
EMAIL_REPLY_TO=

# Your app URL for email CTA buttons
APP_URL=http://localhost:5173
